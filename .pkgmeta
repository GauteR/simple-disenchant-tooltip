# Repo root is the VCS checkout; addon files live under simple-disenchant-tooltip/.
package-as: simple-disenchant-tooltip

move-folders:
  simple-disenchant-tooltip/simple-disenchant-tooltip: simple-disenchant-tooltip

manual-changelog: CHANGELOG.md

ignore:
  - docs
  - tests
  - reports
  - scripts
  - README.md
  - .luarc.json
  - .github
  - CHANGELOG.md
  - MEMORIES.md

enable-nolib-creation: no
